---
layout: null
permalink: /zh/posts.json
---
{% assign lang_posts = site.posts | where: "lang", "zh" %}
[
{% for post in lang_posts limit: 6 %}
  {
    "title": {{ post.title | jsonify }},
    "date": {{ post.date | date: "%Y.%m.%d" | jsonify }},
    "url": {{ post.url | prepend: site.url | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 110 | jsonify }},
    "tags": {{ post.tags | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
